{
  "name": "theme-catalog-kit",
  "version": "0.1.0",
  "description": "Pick a preset palette or craft a custom one, then generate ready-to-paste theme code (CSS variables, button styles, Tailwind config) for your framework.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "theme",
    "themes",
    "design-tokens",
    "css-variables",
    "color-palette",
    "tailwind",
    "code-generator"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./generate": {
      "types": "./dist/lib/generate.d.ts",
      "import": "./dist/lib/generate.js"
    },
    "./themes/ids": {
      "types": "./dist/themes/ids.d.ts",
      "import": "./dist/themes/ids.js"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/i18n/**",
    "**/main.tsx"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && node scripts/copy-data.mjs",
    "prepublishOnly": "npm run build:lib",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "antd": "^6.4.3",
    "classnames": "^2.5.1",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "sass": "^1.100.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
